@page "/session"
@inject SessionState UserSession
<h1>My session</h1><p>This page demonstrates circuit-scoped state. It is not durable authentication or a persistent session.</p><label>Display name</label><input @bind="UserSession.DisplayName" @bind:event="oninput" /><div class="stats"><strong>@UserSession.VisitedEventIds.Count viewed events</strong><strong>@UserSession.RegisteredEventIds.Count registered events</strong></div><p class="muted">Refreshing or reconnecting with a new circuit may reset this data.</p>
