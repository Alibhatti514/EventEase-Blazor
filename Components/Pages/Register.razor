@page "/register/{Id:int}"
@inject EventStore Events
@inject RegistrationStore Registrations
@inject SessionState Session
<h1>Event registration</h1>
@if(item is null){<p>Event not found. <a href="/">Return to events</a></p>}else{<p>Register for <strong>@item.Name</strong> · @item.Date.ToString("MMM d, yyyy")</p>@if(success){<div class="notice success">Registration confirmed! <a href="/attendance">View attendance</a></div>}else{<EditForm Model="form" OnValidSubmit="Submit" FormName="register"><DataAnnotationsValidator/><ValidationSummary/><label>Full name</label><InputText @bind-Value="form.FullName" /><ValidationMessage For="@(()=>form.FullName)"/><label>Email address</label><InputText @bind-Value="form.Email" /><ValidationMessage For="@(()=>form.Email)"/><label>Attendance type</label><InputSelect @bind-Value="form.AttendanceType"><option value="In person">In person</option><option value="Virtual">Virtual</option></InputSelect><button class="button" type="submit">Confirm registration</button>@if(error is not null){<p class="error">@error</p>}</EditForm>}}
@code { [Parameter] public int Id {get;set;} private EventItem? item; private Registration form=new(); private bool success; private string? error; protected override void OnParametersSet(){item=Events.Get(Id);form=new Registration { EventId=Id, FullName=Session.DisplayName??"" };success=false;error=null;} private void Submit(){if(Registrations.Add(form)){Session.DisplayName=form.FullName;Session.RegisteredEventIds.Add(Id);success=true;}else error="This email is already registered for this event, or the form is invalid.";} }
